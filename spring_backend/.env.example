# 프로필 선택 (미설정 시 기본: dev)
SPRING_PROFILES_ACTIVE=dev

# --- Cloudflare R2 / dev (이 파일을 복사해 .env 로 사용, .env는 git에 올리지 말 것) ---
R2_ENABLED=true
R2_ACCOUNT_ID=
R2_BUCKET=pbb-dev
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
R2_KEY_PREFIX=dev/

# --- Sranko ML (FastAPI) ---
SRANKO_ML_ENABLED=true
SRANKO_ML_BASE_URL=http://127.0.0.1:8000

# --- Sranko Vertex Gemini try-on (false / empty project → JPEG stub) ---
SRANKO_VERTEX_ENABLED=false
SRANKO_VERTEX_PROJECT_ID=
SRANKO_VERTEX_LOCATION=us-central1
# Single-call image model (not virtual-try-on-001 — no text prompt on that model).
SRANKO_VERTEX_MODEL=gemini-2.5-flash-image
# Legacy unused (still bind for old .env):
SRANKO_VERTEX_FIT_ENABLED=false
SRANKO_VERTEX_FIT_MODEL=gemini-2.5-flash-image
# If default model 404s in your region: SRANKO_VERTEX_MODEL=gemini-3.1-flash-image
# ADC: gcloud auth application-default login
# Later: GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json

# --- Sranko weather (WeatherAPI.com) ---
WEATHERAPI_KEY=
# WEATHERAPI_BASE_URL=https://api.weatherapi.com

